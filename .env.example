# Local SQLite database. For a bigger install, switch prisma/schema.prisma's
# datasource provider to "postgresql" and point this at a Postgres instance
# instead, then use `npx prisma migrate dev` in place of `db:push`.
DATABASE_URL="file:./dev.db"

# Base URL of this app, once the HTTPS proxy is set up (see the README) —
# https and no port, since everything on the LAN reaches the app through
# that, not directly. Also what scripts/generate-cert.js reads the
# certificate's hostname from if you don't pass one explicitly.
APP_URL="https://localhost"

# Notification provider: "mock" logs the SMS verification code to the
# server console AND returns it directly in the sign-in response, so the
# rider app can show it as if it had arrived — no external account needed
# for a demo or pilot. Switch to "twilio" (and wire server/routes/auth.js's
# sendCode call up to it) once real credentials are supplied.
NOTIFICATION_PROVIDER="mock"

# --- Database backups ---
# The app takes a consistent snapshot of the live database on a schedule
# (and once immediately on startup) — never syncs the live file itself.
# All of these are optional; sensible defaults apply if left unset.

# Where local snapshots are kept. Default: ./backups
# BACKUP_DIR="./backups"

# How often to take a snapshot, in minutes. Default: 60
# BACKUP_INTERVAL_MINUTES=60

# How many local snapshots to keep before deleting the oldest. Local
# retention is count-based since disk space is the real constraint here.
# Default: 72
# BACKUP_RETENTION_COUNT=72

# Optional: also copy each snapshot into a synced folder (e.g. an OneDrive
# path) for off-machine redundancy. Safe to point at OneDrive, unlike the
# live database file — a finished snapshot is static once written.
# BACKUP_MIRROR_DIR="C:\Users\<you>\OneDrive\Apps\RideOps-Backups"

# How many days of mirrored snapshots to keep — age-based rather than
# count-based, since an off-machine copy is worth keeping much longer and
# costs no local disk. Only applies when BACKUP_MIRROR_DIR is set.
# Default: 30
# BACKUP_MIRROR_RETENTION_DAYS=30

# How many backup failures in a row before /api/health reports unhealthy.
# Default: 3
# BACKUP_ALERT_AFTER_FAILURES=3

# --- Field-level encryption ---
# Encrypts sensitive fields (rider phone numbers) before they're ever
# written — protects them in the live database, every local backup, and
# the OneDrive mirror alike, since it travels with the data rather than
# being applied to specific files after the fact. Required; the app throws
# on startup the first time it needs to encrypt or decrypt a value if this
# isn't set. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Back this up somewhere separate from the database — losing it makes
# every already-encrypted row permanently unreadable, backups included.
DATA_ENCRYPTION_KEY=""

# --- HTTPS reverse proxy ---
# The app itself only ever binds 127.0.0.1 (see start:internal in
# package.json) — this is what's actually reachable from the LAN. Both
# optional; defaults shown.

# Port the HTTPS proxy listens on. Falls back to 8443 automatically if 443
# can't be bound. Default: 443
# HTTPS_PORT=443

# Port the app itself listens on, loopback-only. Default: 3000
# INTERNAL_PORT=3000
